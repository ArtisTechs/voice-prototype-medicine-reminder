# Copy to .env:  cp .env.example .env   (never commit .env)

# ---- Network ---------------------------------------------------------------
# This laptop's IP as the phone app sees it. start-voice.cmd fills it in on every start.
LAN_IP=192.168.1.20
# The app's API base URL. Leave unset to use http://LAN_IP:API_PORT. In prod use https://<your-domain>.
# EXPO_PUBLIC_API_URL=
# true = run Expo with --tunnel (ngrok) when the phone cannot reach the PC on the LAN.
EXPO_TUNNEL=false
# go = open in Expo Go (default). dev-client = open in the development build (remote push on Android).
EXPO_CLIENT=go
# Expo project id (only needed for push tokens in a dev-client build; see docs/setup.md).
EXPO_PUBLIC_EXPO_PROJECT_ID=

# ---- Database (MySQL 8.4 in Docker) --------------------------------------------------------
# Used by the db container the first time it starts, and by the API to connect.
MYSQL_DATABASE=medrem
MYSQL_USER=medrem
MYSQL_PASSWORD=medrem-dev-password
MYSQL_ROOT_PASSWORD=medrem-root-dev-password
# Another MySQL 8 instead of the db container (URL-encode special characters in the password). Empty = local container.
# DATABASE_URL=mysql://user:password@host:3306/medrem

# ---- API -----------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# Generate one: make secret   (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Comma-separated browser origins (native apps do not need CORS).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# The pillbox clock zone (firmware is fixed to Philippine time).
DEVICE_TZ=Asia/Manila
# Create the demo caregiver/patient/pillbox on startup (dev only).
SEED_DEMO=true
# Run cron jobs inside the API process (Render single-service deploy). Compose uses the worker container instead.
EMBED_WORKER=false
RATE_LIMIT_ENABLED=true
# Internet-facing server only: the device's BACKEND_URL becomes http://<host>:5055/d/<this secret>
# and the bare device paths answer 404. deploy/server-setup.sh generates it. Empty = LAN mode.
DEVICE_PATH_SECRET=

# ---- Scans: Gemini (free tier) ---------------------------------------------------------------
# Get a key at https://aistudio.google.com/apikey. It lives here only: never in the app, the firmware or git.
# Free-tier notice: Google may use free-tier inputs (the package photos and the medicine list) to improve its products.
GEMINI_API_KEY=
# A current Flash model. Change it here if Google retires this one.
GEMINI_MODEL=gemini-2.5-flash
# Accept a Gemini match only at or above this confidence (0-1); below it the scan answers "not found".
SCAN_MIN_CONFIDENCE=0.7
# Abort the Gemini call after this long (ms). The camera gives up at 15 s; the contract promises an answer in 10 s.
GEMINI_TIMEOUT_MS=8000
# Stay under the free tier's per-minute limit (requests per minute across all boxes).
GEMINI_MAX_PER_MINUTE=10
# Also send up to one reference photo per medicine with each scan (more accurate, slower; off by default).
SCAN_USE_REFERENCES=false
SCAN_RETENTION_DAYS=30

# ---- Push ----------------------------------------------------------------------
EXPO_PUSH_ENABLED=true
# Optional: an Expo access token if "enhanced push security" is on for the project.
EXPO_ACCESS_TOKEN=

# ---- Prod (docker-compose.prod.yml) ---------------------------------------------
# Public hostname for HTTPS via Caddy (the app). The ESP32 keeps using http://LAN_IP:5055.
APP_DOMAIN=medrem.example.com

# Dev-only database browser (Adminer) port on localhost.
ADMINER_PORT=8089
