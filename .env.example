# Copy to .env:  cp .env.example .env   (never commit .env)

# ---- Network ---------------------------------------------------------------
# This PC's WiFi IPv4 (ipconfig -> "Wireless LAN adapter Wi-Fi"). The phone and the ESP32 use it.
LAN_IP=192.168.1.20
# The app's API base URL. Default works on the LAN. In prod use https://<your-domain>.
EXPO_PUBLIC_API_URL=http://${LAN_IP}:5000
# true = run Expo with --tunnel (ngrok) when the phone cannot reach the PC on the LAN.
EXPO_TUNNEL=false
# Expo project id (only needed for push tokens in a dev-client build; see docs/setup.md).
EXPO_PUBLIC_EXPO_PROJECT_ID=

# ---- Database ----------------------------------------------------------------
POSTGRES_USER=medrem
POSTGRES_PASSWORD=medrem-dev-password
POSTGRES_DB=medrem

# ---- API -----------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
# Generate one: make secret   (at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Comma-separated browser origins (native apps do not need CORS).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# The pillbox clock zone (firmware is fixed to Philippine time).
DEVICE_TZ=Asia/Manila
# Create the demo caregiver/patient/pillbox on startup (dev only).
SEED_DEMO=true
RATE_LIMIT_ENABLED=true

# ---- Scans / vision ------------------------------------------------------------
SCAN_RETENTION_DAYS=30
SCAN_BUDGET_SECONDS=8.5
VISION_ENABLED=true
VISION_OCR_THRESHOLD=80
VISION_OCR_MARGIN=8
VISION_EMBED_THRESHOLD=0.85
VISION_EMBED_MARGIN=0.03
# Optional Claude vision fallback (off by default). Needs both values.
VISION_LLM_FALLBACK=false
ANTHROPIC_API_KEY=

# ---- Push ----------------------------------------------------------------------
EXPO_PUSH_ENABLED=true
# Optional: an Expo access token if "enhanced push security" is on for the project.
EXPO_ACCESS_TOKEN=

# ---- Prod (docker-compose.prod.yml) ---------------------------------------------
# Public hostname for HTTPS via Caddy (the app). The ESP32 keeps using http://LAN_IP:5000.
APP_DOMAIN=medrem.example.com

# Dev-only DB browser port on localhost.
ADMINER_PORT=8089
