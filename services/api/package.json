{
  "name": "voice-api",
  "version": "1.0.0",
  "private": true,
  "description": "MIRA medicine reminder API + worker (Express, MySQL, Gemini)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "eval-vision": "tsx scripts/eval-vision.ts"
  },
  "dependencies": {
    "@google/genai": "1.52.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "cors": "2.8.6",
    "express": "5.1.0",
    "fastest-levenshtein": "1.0.16",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "multer": "2.5.0",
    "node-cron": "3.0.3",
    "pino": "9.14.0",
    "prisma": "6.19.3",
    "sharp": "0.34.5",
    "ws": "8.22.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/node-cron": "3.0.11",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
