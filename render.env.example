# Where to put the credentials for Render.
# Render dashboard > voice-api > Environment > "Add from .env" (paste the filled-in lines), or type them one by one.
# This file is only a checklist: never commit the filled-in copy.

# ---- REQUIRED: you provide these ------------------------------------------------------------
# An outside MySQL 8 (Render has none). Free options: Aiven for MySQL, TiDB Cloud Serverless.
# Create an empty database called medrem; the API creates the tables itself on start.
# URL-encode special characters in the password (@ -> %40, / -> %2F). Cloud MySQL usually needs TLS: append ?sslaccept=strict
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/medrem?sslaccept=strict

# The provider's CA certificate (Aiven: service Overview > CA certificate). Paste the whole PEM, BEGIN/END lines included.
# The container writes it to a file and adds sslcert=... to DATABASE_URL.
DATABASE_CA_CERT=

# Scans only work with this. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- OPTIONAL ----------------------------------------------------------------------------
# Expo access token, only if "enhanced push security" is on for your Expo project.
EXPO_ACCESS_TOKEN=
# Browser origins that may call the API (the phone app does not need this).
CORS_ORIGINS=

# ---- Generated or wired by render.yaml (do not fill) ----------------------------------------
# JWT_SECRET           generated by Render
# DEVICE_PATH_SECRET   generated by Render. Copy it after the first deploy: firmware BACKEND_URL = https://<service>.onrender.com/d/<DEVICE_PATH_SECRET>
# REDIS_URL            from the voice-redis Key Value instance
# PORT                 set by Render (the API follows it)

# ---- In the app (apps/mobile/.env, not on Render) ----------------------------------------------
# EXPO_PUBLIC_API_URL=https://<service>.onrender.com
